{
    "model": {
        "model_type": "hf",
        "hf_model_name": "Qwen/Qwen2.5-0.5B"
    },
    "train": {
        "max_steps": 1000,
        "warmup_steps": 50,
        "max_lr": 1e-4,
        "weight_decay": 0.1,
        "grad_clip": 1.0,
        "total_batch_size": 16384,
        "eval_loss": {
            "every": 100,
            "steps": 10
        },
        "eval_generate": {
            "every": 100,
            "prompt": "Today is a nice day, because",
            "samples": 5,
            "max_tokens": 50
        },
        "eval_hellaswag": {
            "every": 500
        },
        "checkpoint_every": 500,
        "checkpoint_dir": "checkpoints/qwen_0.5b",
        "resume_from": null,
        "log_every": 10,
        "wandb_project": "saffron"
    },
    "data": {
        "data_root": "data/qwen2.5/HuggingFaceFW_fineweb-edu",
        "batch_size": 4,
        "seq_len": 1024,
        "tokenizer": "Qwen/Qwen2.5-0.5B"
    },
    "prep": {
        "data_root": "data/qwen2.5/HuggingFaceFW_fineweb-edu",
        "dataset": "HuggingFaceFW/fineweb-edu",
        "name": "sample-10BT",
        "tokenizer": "Qwen/Qwen2.5-0.5B",
        "dataset_split": "train",
        "shard_size": 100000000,
        "num_validation_shards": 1
    }
}
