{
    "model": {
        "model_type": "hf",
        "hf_model_name": "Qwen/Qwen2.5-0.5B"
    },
    "train": {
        "max_steps": 1000,
        "grad_clip": 1.0,
        "total_batch_size": 16384,
        "compile_model": true,
        "eval_loss": {
            "every": 100,
            "steps": 10
        },
        "eval_generate": {
            "every": 100,
            "prompt": "Today is a nice day, because",
            "samples": 5,
            "max_tokens": 50,
            "use_chat_template": false
        },
        "eval_hellaswag": {
            "every": 500
        },
        "eval_gsm8k": {
            "every": null
        },
        "checkpoint_every": 500,
        "checkpoint_dir": "checkpoints/qwen_0.5b",
        "resume_from": null,
        "log_every": 10,
        "wandb_project": "saffron"
    },
    "optimizer": {
        "type": "adamw",
        "lr": 0.0001,
        "weight_decay": 0.1,
        "betas": [
            0.9,
            0.95
        ],
        "eps": 1e-08,
        "schedule": {
            "type": "cosine",
            "warmup_steps": 50,
            "min_lr_ratio": 0.1
        }
    },
    "data": {
        "data_root": "data/qwen2.5/HuggingFaceFW_fineweb-edu",
        "batch_size": 4,
        "seq_len": 1024,
        "tokenizer": "Qwen/Qwen2.5-0.5B",
        "loader_type": "pretrain"
    },
    "prep": {
        "data_root": "data/qwen2.5/HuggingFaceFW_fineweb-edu",
        "dataset": "HuggingFaceFW/fineweb-edu",
        "name": "sample-10BT",
        "tokenizer": "Qwen/Qwen2.5-0.5B",
        "dataset_split": "train",
        "shard_size": 100000000,
        "num_validation_shards": 1
    }
}
