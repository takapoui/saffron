{
    "model": {
        "model_type": "neogpt",
        "tokenizer": "gpt2",
        "vocab_size": 50257,
        "n_embd": 2048,
        "block_size": 1024,
        "n_layer": 24,
        "n_head": 16,
        "rope_base": 10000,
        "mlp_hidden_dim": 5632,
        "n_kv_head": 4
    },
    "train": {
        "max_steps": 19073,
        "grad_clip": 1.0,
        "total_batch_size": 524288,
        "compile_model": true,
        "eval_loss": {
            "every": 250,
            "steps": 20
        },
        "eval_generate": {
            "every": 100,
            "prompt": "Today is a nice day, because",
            "samples": 5,
            "max_tokens": 50,
            "use_chat_template": false
        },
        "eval_hellaswag": {
            "every": 1000
        },
        "eval_gsm8k": {
            "every": null
        },
        "checkpoint_every": 1000,
        "checkpoint_dir": "checkpoints/neogpt_1b",
        "resume_from": null,
        "log_every": 10,
        "wandb_project": "saffron"
    },
    "optimizer": {
        "type": "adamw",
        "lr": 0.0003,
        "weight_decay": 0.1,
        "betas": [
            0.9,
            0.95
        ],
        "eps": 1e-08,
        "schedule": {
            "type": "cosine",
            "warmup_steps": 715,
            "min_lr_ratio": 0.1
        }
    },
    "data": {
        "data_root": "data/gpt2/HuggingFaceFW_fineweb-edu",
        "batch_size": 16,
        "seq_len": 1024,
        "tokenizer": "gpt2",
        "loader_type": "pretrain"
    },
    "prep": {
        "data_root": "data/gpt2/HuggingFaceFW_fineweb-edu",
        "dataset": "HuggingFaceFW/fineweb-edu",
        "name": "sample-10BT",
        "tokenizer": "gpt2",
        "dataset_split": "train",
        "shard_size": 100000000,
        "num_validation_shards": 1
    }
}
