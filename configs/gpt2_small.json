{
    "model": {
        "model_type": "gpt2",
        "vocab_size": 50257,
        "n_embd": 768,
        "block_size": 1024,
        "n_layer": 12,
        "n_head": 12
    },
    "train": {
        "max_steps": 19073,
        "warmup_steps": 715,
        "max_lr": 6e-4,
        "weight_decay": 0.1,
        "grad_clip": 1.0,
        "total_batch_size": 524288,
        "eval_loss": {
            "every": 250,
            "steps": 20
        },
        "eval_generate": {
            "every": 100,
            "prompt": "Today is a nice day, because",
            "samples": 5,
            "max_tokens": 50
        },
        "eval_hellaswag": {
            "every": 1000
        },
        "checkpoint_every": 1000,
        "checkpoint_dir": "checkpoints/gpt2_small",
        "resume_from": null,
        "log_every": 10,
        "wandb_project": "saffron"
    },
    "data": {
        "data_root": "data/gpt2/HuggingFaceFW_fineweb-edu",
        "batch_size": 32,
        "seq_len": 1024,
        "tokenizer": "gpt2"
    },
    "prep": {
        "data_root": "data/gpt2/HuggingFaceFW_fineweb-edu",
        "dataset": "HuggingFaceFW/fineweb-edu",
        "name": "sample-10BT",
        "tokenizer": "gpt2",
        "dataset_split": "train",
        "shard_size": 100000000,
        "num_validation_shards": 1
    }
}
